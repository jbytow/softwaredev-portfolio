# Database Configuration
# POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD: required in production (docker-compose.prod.yml fails without them)
POSTGRES_DB=devportfolio
POSTGRES_USER=devportfolio
POSTGRES_PASSWORD=your_secure_password_here

# Backend Configuration
SPRING_PROFILES_ACTIVE=dev
# required in production (docker-compose.prod.yml fails without it)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# OAuth2 Configuration
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET: required in production (docker-compose.prod.yml fails without them)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Admin Whitelist (comma-separated emails)
# required in production (docker-compose.prod.yml fails without it)
ADMIN_EMAILS=admin@example.com

# Frontend Configuration
# required in production (docker-compose.prod.yml fails without it)
FRONTEND_URL=http://localhost:5173
# optional (build-time API base URL)
VITE_API_URL=/api

# File Storage: the upload limit is fixed at 50 MB in application.yml (spring.servlet.multipart)
# and nginx/nginx.conf (client_max_body_size); change both together. The upload path is fixed by the compose volume.

# Email Configuration (for contact form)
# MAIL_* and CONTACT_EMAIL: optional (not enforced by docker-compose.prod.yml)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
CONTACT_EMAIL=where-to-receive-contact-form@example.com
